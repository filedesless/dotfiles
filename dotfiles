#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
home_dir=${HOME:?HOME must be set}
force_link=false
ignore_existing=false

usage() {
    cat <<EOF
Usage:
  $(basename "$0") link [-f|--force] [-i|--ignore-existing] [PATH...]
  $(basename "$0") add PATH...
  $(basename "$0") unlink [PATH...]
  $(basename "$0") status [PATH...]
  $(basename "$0") list

With no PATH, link links every dotfile and status checks every dotfile.
PATH is a file relative to this repository, or a path under ~, such as
.profile or .config/niri/config.kdl.
Running $(basename "$0") without a command prints this usage.

--force replaces existing targets without prompting. --ignore-existing skips
existing targets; --force takes precedence when both are specified.
EOF
}

die() {
    printf '%s\n' "dotfiles: $*" >&2
    exit 1
}

validate_file() {
    file=$1

    case $file in
        ""|/*|../*|*/../*|*/..|..)
            die "FILE must be a relative path inside the repository: $file"
            ;;
    esac

    [ -f "$repo_dir/$file" ] ||
        die "repository path is not a regular file: $file"
}

validate_path() {
    file=$1

    case $file in
        ""|/*|../*|*/../*|*/..|..)
            die "FILE must be a relative path inside the repository: $file"
            ;;
    esac
}

normalize_path() {
    file=$1

    while [ "${file%/}" != "$file" ]; do
        file=${file%/}
    done
    [ -n "$file" ] || die "PATH must not be empty"
    printf '%s\n' "$file"
}

add_path() {
    file=$1

    case $file in
        "$home_dir"/*)
            file=${file#"$home_dir"/}
            ;;
    esac
    file=$(normalize_path "$file")
    validate_path "$file"
    printf '%s\n' "$file"
}

add_path_entry() {
    file=$(add_path "$1")
    source=$home_dir/$file
    target=$repo_dir/$file

    [ ! -L "$source" ] ||
        die "home path is already a symlink; manage its target instead: $source"
    [ -f "$source" ] ||
        die "home path is not a regular file: $source"
    [ ! -e "$target" ] && [ ! -L "$target" ] ||
        die "repository file already exists: $file"

    mkdir -p "$(dirname "$target")"
    cp -p "$source" "$target"
    rm "$source"
    ln -s "$target" "$source"
    printf 'added and linked %s\n' "$file"
}

link_file() {
    file=$(normalize_path "$1")
    source=$repo_dir/$file
    target=$home_dir/$file

    validate_file "$file"
    mkdir -p "$(dirname "$target")"

    if [ -L "$target" ]; then
        [ "$(readlink "$target")" = "$source" ] &&
            printf 'already linked  %s\n' "$file" && return
    elif [ ! -e "$target" ]; then
        ln -s "$source" "$target"
        printf 'linked          %s\n' "$file"
        return
    fi

    if [ "$ignore_existing" = true ] && [ "$force_link" != true ]; then
        printf 'already exists   %s\n' "$file"
        return
    fi

    if [ "$force_link" = true ]; then
        rm -r "$target"
    else
        printf 'warning: link will replace existing target: %s\n' "$target" >&2
        printf 'Continue? [y/N] ' >&2
        read answer </dev/tty || answer=
        case $answer in
            y|Y|yes|YES)
                rm -r "$target"
                ;;
            *)
                die "link cancelled: $file"
                ;;
        esac
    fi

    ln -s "$source" "$target"
    printf 'linked          %s\n' "$file"
}

link_all() {
    find "$repo_dir" -type d -name .git -prune -o -type f -print |
        while IFS= read -r path; do
        file=${path#"$repo_dir"/}

        case $file in
            dotfiles|README.md)
                ;;
            *)
                link_file "$file"
                ;;
        esac
    done
}

unlink_file() {
    file=$(normalize_path "$1")
    source=$repo_dir/$file
    target=$home_dir/$file

    validate_file "$file"

    if [ ! -e "$target" ] && [ ! -L "$target" ]; then
        printf 'already absent   %s\n' "$file"
        return
    fi

    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] ||
        die "refusing to remove a non-managed target: $target"

    rm "$target"
    printf 'removed          %s\n' "$file"
}

unlink_all() {
    list_managed | while IFS= read -r file; do
        unlink_file "$file"
    done
}

status_file() {
    file=$(normalize_path "$1")
    source=$repo_dir/$file
    target=$home_dir/$file

    validate_file "$file"

    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
        printf 'linked           %s\n' "$file"
    elif [ -e "$target" ] || [ -L "$target" ]; then
        printf 'not managed      %s\n' "$file"
    else
        printf 'missing           %s\n' "$file"
    fi
}

status_all() {
    find "$repo_dir" -type d -name .git -prune -o -type f -print |
        while IFS= read -r path; do
        file=${path#"$repo_dir"/}

        case $file in
            dotfiles|README.md)
                ;;
            *)
                status_file "$file"
                ;;
        esac
    done
}

list_managed() {
    find "$repo_dir" -type d -name .git -prune -o -type f -print |
        while IFS= read -r path; do
        file=${path#"$repo_dir"/}

        case $file in
            dotfiles|README.md)
                ;;
            *)
                target=$home_dir/$file
                if [ -L "$target" ] &&
                    [ "$(readlink "$target")" = "$path" ]; then
                    printf '%s\n' "$file"
                fi
                ;;
        esac
    done
}

[ "$#" -ge 1 ] || {
    usage
    exit 0
}

command=$1
shift

case $command in
    -h|--help|help)
        usage
        exit 0
        ;;
esac

case $command in
    add)
        for file do add_path_entry "$file"; done
        ;;
    link)
        force_link=false
        ignore_existing=false
        while [ "$#" -gt 0 ]; do
            case $1 in
                -f|--force)
                    force_link=true
                    ;;
                -i|--ignore-existing)
                    ignore_existing=true
                    ;;
                --)
                    shift
                    break
                    ;;
                -*)
                    die "unknown link option: $1"
                    ;;
                *)
                    break
                    ;;
            esac
            shift
        done
        if [ "$#" -eq 0 ]; then
            link_all
        else
            for file do link_file "$file"; done
        fi
        ;;
    unlink)
        if [ "$#" -eq 0 ]; then
            unlink_all
        else
            for file do unlink_file "$file"; done
        fi
        ;;
    status)
        if [ "$#" -eq 0 ]; then
            status_all
        else
            for file do status_file "$file"; done
        fi
        ;;
    list)
        [ "$#" -eq 0 ] || {
            usage >&2
            exit 1
        }
        list_managed
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
