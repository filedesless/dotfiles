layout {

    focus-ring {
        active-color   "#8b8fc1"
        inactive-color "#1a1a23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b8fc1"
        inactive-color "#1a1a23"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#8b8fc1"
        inactive-color "#2f346a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b8fc180"
    }
}

recent-windows {
    highlight {
        active-color "#8b8fc1"
        urgent-color "#fd4663"
    }
}
